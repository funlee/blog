{
  "name": "yichen-blog",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && node scripts/index-search.mjs && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "start": "npm run build && npm run preview",
    "test": "node --test tests/*.test.mjs",
    "new": "node scripts/new-content.mjs",
    "sync:reading": "node --env-file-if-exists=.env scripts/sync-reading.mjs"
  },
  "dependencies": {
    "astro": "7.3.8",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "~5.9.3",
    "pagefind": "1.5.2"
  }
}
