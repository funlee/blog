---
import {ClientRouter} from 'astro:transitions';import {site} from '../config/site';import {url} from '../lib/content';import Banner from '../components/Banner.astro';import Sidebar from '../components/Sidebar.astro';import Icon from '../components/Icon.astro';import '../styles/global.css';
interface Props {title?:string;description?:string;home?:boolean;full?:boolean}
const {title,description=site.description,home=false,full=false}=Astro.props;const nav=[['','博客'],['moments/','碎碎念'],['reading/','读书'],['friends/','友链'],['archives/','归档'],['about/','关于']];
const path=Astro.url.pathname;const canonical=new URL(path,Astro.site);const active=(p:string)=>p?path.startsWith(url(p)):path===url('')||path.startsWith(url('page/'))||path.startsWith(url('posts/'));
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#3768b0"/><title>{title?`${title} · ${site.name}`:site.name}</title><link rel="icon" href={url('favicon.svg')}/><link rel="canonical" href={canonical}/><link rel="alternate" type="application/rss+xml" title={site.name} href={url('rss.xml')}/><meta property="og:title" content={title||site.name}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(url('images/mountains.svg'),Astro.site)}/><ClientRouter/>
<script is:inline>function setInitialTheme(){let t='system';try{t=localStorage.getItem('theme')||'system'}catch{}document.documentElement.dataset.theme=t==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):t;document.documentElement.dataset.preference=t}setInitialTheme();document.addEventListener('astro:after-swap',setInitialTheme);</script><slot name="head"/></head>
<body data-base={import.meta.env.BASE_URL}><a class="skip-link" href="#main">跳至正文</a>
<header class="site-header"><div class="nav-wrap"><a class="brand" href={url('')}><span class="brand-mark">逸</span>{site.name}<span class="brand-dot">.</span></a><nav class="desktop-nav" aria-label="主导航">{nav.map(([p,label])=><a class:list={{active:active(p)}} href={url(p)} aria-current={active(p)?'page':undefined}>{label}</a>)}</nav><div class="nav-actions"><button class="search-trigger" data-search aria-label="搜索文章"><Icon name="search"/><span>搜索</span><kbd>⌘ K</kbd></button><span class="nav-divider"></span><button class="icon-button" data-theme aria-label="切换主题"><Icon name="sun"/></button><button class="icon-button mobile-menu" data-menu aria-label="打开导航" aria-expanded="false"><Icon name="menu"/></button></div></div></header>
<dialog id="mobile-nav" class="mobile-dialog"><div class="dialog-heading"><b>去哪里逛逛？</b><button data-close class="icon-button" aria-label="关闭导航"><Icon name="close"/></button></div>{nav.map(([p,label])=><a href={url(p)} aria-current={active(p)?'page':undefined}>{label}<span>↗</span></a>)}<a href={url('categories/')}>分类</a><a href={url('tags/')}>标签</a></dialog>
{home ? <Banner/> : <section class="hero compact" style={`--hero-image:url('${url('images/mountains.svg')}')`}><div class="hero-inner"><span class="eyebrow">NOTES, IDEAS & EVERYDAY LIFE</span><h1>{title}</h1><p>{description}</p></div></section>}
<div class:list={['page-grid',{full}]}><Sidebar/><main id="main" tabindex="-1"><slot/></main></div>
<footer><a class="footer-brand" href={url('')}>{site.name}<span>.</span></a><p>记录所见，珍藏所想。</p><div><span>© {new Date().getFullYear()} {site.author}</span><span>Built with Astro · 用心记录</span></div></footer>
<button class="back-top icon-button" aria-label="返回顶部" hidden>↑</button>
<dialog id="search-dialog"><div class="dialog-heading"><h2>寻找一段记录</h2><button data-close class="icon-button" aria-label="关闭搜索"><Icon name="close"/></button></div><label class="search-input-wrap"><Icon name="search"/><input id="search-input" type="search" placeholder="搜索文章、关键词…" autocomplete="off" aria-label="搜索关键词"/></label><p id="search-status" role="status">输入关键词，探索这里的记录。</p><div id="search-results"></div><button id="search-more" class="soft-button" hidden>显示更多</button><div class="search-hint">↑ ↓ 选择 · Enter 打开 <span>Esc 关闭</span></div></dialog>
<dialog id="lightbox"><button class="icon-button" data-close aria-label="关闭图片"><Icon name="close"/></button><img alt=""/><p></p><div><button class="soft-button" data-prev aria-label="上一张图片">← 上一张</button><button class="soft-button" data-next aria-label="下一张图片">下一张 →</button></div></dialog>
<script>import '../scripts/client';</script></body></html>
