---
interface Props{current:number;total:number;prefix?:string}
const {current,total,prefix=''}=Astro.props;import {url} from '../lib/content';const href=(n:number)=>url(n===1?prefix:`${prefix}page/${n}/`);
---
{total>1&&<nav class="pagination" aria-label="分页">{current>1&&<a href={href(current-1)} aria-label="上一页">←</a>}{Array.from({length:total},(_,i)=>i+1).map(n=><a class:list={{active:n===current}} href={href(n)} aria-current={n===current?'page':undefined}>{n}</a>)}{current<total&&<a href={href(current+1)} aria-label="下一页">→</a>}<span>共 {total} 页</span></nav>}
