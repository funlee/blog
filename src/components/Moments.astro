---
import Base from '../layouts/Base.astro';import Pagination from './Pagination.astro';import {moments,url,date} from '../lib/content';import {render} from 'astro:content';import {site} from '../config/site';import {paginate} from '../lib/core.mjs';const {page=1}=Astro.props;const pages=paginate(await moments(),site.momentPageSize);const items=await Promise.all(pages[page-1].map(async(m:any)=>({...m,...await render(m)})));
---
<Base title="动态" description="不必长篇大论，片刻也值得记录。"><div class="section-heading"><h2>此时，此刻<span>碎片日常</span></h2><span class="muted">LIFE LATELY</span></div><div class="moments">{items.map(({data,Content}:any)=><article class="panel moment"><img class="small-avatar" src={url('images/avatar.svg')} width="42" height="42" alt=""/><div class="moment-body"><header><b>{site.author}</b><time datetime={data.publishedAt}>{date(data.publishedAt)}</time></header><div class="prose"><Content/></div>{data.images.length>0&&<div class="moment-images">{data.images.map((im:any)=><button class="image-button" aria-label={`放大：${im.alt}`}><img src={url(im.src)} alt={im.alt} width="500" height="300" loading="lazy" data-zoom/></button>)}</div>}<span class="moment-foot">☘ 记录一个小瞬间</span></div></article>)}</div><Pagination current={page} total={pages.length} prefix="moments/"/></Base>
