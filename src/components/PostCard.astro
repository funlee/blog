---
import type {CollectionEntry} from 'astro:content';import {categoryName,tagName} from '../config/site';import {url,date} from '../lib/content';import {reading} from '../lib/core.mjs';import Icon from './Icon.astro';
interface Props{post:CollectionEntry<'posts'>}
const {post}=Astro.props;const p=post.data;const r=reading(post.body);
---
<article class="post-card">{p.cover&&<a class="cover" href={url(`posts/${p.slug}/`)} aria-label={p.title}><img src={url(p.cover)} alt="" width="720" height="280" loading="lazy"/></a>}<div class="post-content"><div class="post-meta">{p.pinned>0&&<span class="post-pin">置顶</span>}<a href={url(`categories/${p.category}/`)}>{categoryName(p.category)}</a><span>·</span><time datetime={p.publishedAt}>{date(p.publishedAt)}</time></div><h2><a href={url(`posts/${p.slug}/`)}>{p.title}</a></h2><p>{p.description||post.body?.slice(0,100)}</p><div class="post-bottom"><div>{p.tags.slice(0,3).map(t=><a href={url(`tags/${t}/`)}>#{tagName(t)}</a>)}</div><span>{r.minutes} 分钟阅读</span><a class="read-arrow" aria-label={`阅读 ${p.title}`} href={url(`posts/${p.slug}/`)}><Icon name="arrow" size={18}/></a></div></div></article>
