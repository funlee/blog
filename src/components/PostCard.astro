---
import type {CollectionEntry} from 'astro:content';import {categoryName,tagName} from '../config/site';import {url,date} from '../lib/content';import {reading} from '../lib/core.mjs';import Icon from './Icon.astro';
interface Props{post:CollectionEntry<'posts'>;featured?:boolean}
const {post,featured=false}=Astro.props;const p=post.data;const r=reading(post.body);
---
<article class:list={['post-card',{featured}]}><a class:list={['cover',{placeholder:!p.cover}]} href={url(`posts/${p.slug}/`)} aria-label={p.title}>{p.cover?<img src={url(p.cover)} alt="" width="720" height="280" loading="lazy"/>:<div class="cover-type"><span>{p.tags[0]?.toUpperCase()||'NOTES'}</span><Icon name="leaf" size={70}/><small>THOUGHTS & EXPLORATIONS</small></div>}{p.pinned>0&&<span class="pin-badge">↟ 置顶文章</span>}</a><div class="post-content"><div class="post-meta"><a href={url(`categories/${p.category}/`)}>{categoryName(p.category)}</a><span>·</span><time datetime={p.publishedAt}>{date(p.publishedAt)}</time></div><h2><a href={url(`posts/${p.slug}/`)}>{p.title}</a></h2><p>{p.description||post.body?.slice(0,100)}</p><div class="post-bottom"><div>{p.tags.slice(0,3).map(t=><a href={url(`tags/${t}/`)}>#{tagName(t)}</a>)}</div><span>{r.minutes} 分钟阅读</span><a class="read-arrow" aria-label={`阅读 ${p.title}`} href={url(`posts/${p.slug}/`)}><Icon name="arrow" size={18}/></a></div></div></article>
