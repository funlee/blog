---
import Base from '../layouts/Base.astro';import PostCard from './PostCard.astro';import Pagination from './Pagination.astro';import {categories,site} from '../config/site';import {posts,url} from '../lib/content';import {homeOrder,paginate} from '../lib/core.mjs';const {page=1}=Astro.props;const all=homeOrder(await posts());const pages=paginate(all,site.pageSize);const items=pages[page-1];
---
<Base home title={page>1?`第 ${page} 页`:undefined}><div class="section-heading"><div><span class="eyebrow">THE JOURNAL</span><h2>最近的记录<span>{all.length.toString().padStart(2,'0')}</span></h2></div><a href={url('archives/')}>全部归档 ↗</a></div><nav class="filter-tabs" aria-label="按分类浏览"><a class="active" href={url('')}>全部文章</a>{categories.filter(c=>all.some(p=>p.data.category===c.id)).map(c=><a href={url(`categories/${c.id}/`)}>{c.name}</a>)}<span class="filter-note">保持好奇，持续记录</span></nav><div class="post-grid">{items.map((p:any)=><PostCard post={p}/>)}</div>{!items.length&&<div class="panel empty">还没有发布文章。</div>}<Pagination current={page} total={pages.length}/></Base>
