---
import Home from '../../components/Home.astro';import {posts} from '../../lib/content';import {site} from '../../config/site';
export async function getStaticPaths(){const count=Math.ceil((await posts()).length/site.pageSize);return Array.from({length:Math.max(0,count-1)},(_,i)=>({params:{page:String(i+2)},props:{page:i+2}}));}const {page}=Astro.props;
---
<Home page={page}/>
