---
import Moments from '../../../../components/Moments.astro';
import { moments } from '../../../../lib/content';
import { momentYears } from '../../../../lib/moments.mjs';
import { paginate } from '../../../../lib/core.mjs';
import { site } from '../../../../config/site';

export async function getStaticPaths() {
  return momentYears(await moments()).flatMap(([year, items]) =>
    paginate(items, site.momentPageSize).map((_, index) => ({
      params: { year, page: index === 0 ? undefined : `page/${index + 1}` },
      props: { year, page: index + 1 },
    })),
  );
}
const { year, page } = Astro.props;
---
<Moments year={year} page={page} />
