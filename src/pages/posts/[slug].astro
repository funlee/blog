---
import Base from '../../layouts/Base.astro';import {posts,url,date} from '../../lib/content';import {render} from 'astro:content';import {reading} from '../../lib/core.mjs';import {site,categoryName,tagName} from '../../config/site';
export async function getStaticPaths(){const all=await posts();return all.map((post,i)=>({params:{slug:post.data.slug},props:{post,older:all[i+1],newer:all[i-1]}}));}
const {post,older,newer}=Astro.props;const {Content,headings}=await render(post);const p=post.data;const stats=reading(post.body);const toc=headings.filter(h=>h.depth===2||h.depth===3);
---
<Base title={p.title} description={p.description}><script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:p.title,datePublished:p.publishedAt,dateModified:p.updatedAt||p.publishedAt,author:{'@type':'Person',name:site.author}}).replaceAll('<','\u003c')}/><article class="panel article" data-pagefind-body><a class="back-link" data-pagefind-ignore href={url('')}>← 返回文章列表</a><header class="article-header"><a class="category-pill" data-pagefind-ignore href={url(`categories/${p.category}/`)}>{categoryName(p.category)}</a><h1 data-pagefind-meta="title" data-pagefind-weight="10">{p.title}</h1><div class="muted" data-pagefind-ignore>{site.author} · <time datetime={p.publishedAt}>{date(p.publishedAt)}</time> · {stats.words} 字 · 预计 {stats.minutes} 分钟</div>{p.updatedAt&&<p class="tiny">更新于 {date(p.updatedAt)}</p>}{(p.source === "juejin" || p.source === "zhihu") && <p class="tiny" data-pagefind-ignore>迁移自 <a href={p.sourceUrl}>{p.source === "zhihu" ? "知乎原文" : "掘金原文"}</a>{p.source === "zhihu" ? " · 本文写于 2016 年，保留当时的个人经历与技术背景。" : p.publishedAt.startsWith("2019") && " · 本文写于 2019 年，技术示例保留当时的版本背景。"}</p>}<!-- 原始笔记需登录印象笔记账号查看。 -->{p.source === "yinxiang" && <p class="tiny" data-pagefind-ignore>迁移自 <a href={p.sourceUrl}>印象笔记原文</a> · 笔记创建于 {date(p.sourceCreatedAt || p.publishedAt)}，迁移时整理与修订。</p>}<div class="tag-list" data-pagefind-ignore>{p.tags.map(t=><a href={url(`tags/${t}/`)}>#{tagName(t)}</a>)}</div></header>{p.cover&&<img class="article-cover" src={url(p.cover)} width="1000" height="389" alt="文章山峦插画" data-zoom/>}{toc.length>=2&&<details class="toc" open data-pagefind-ignore><summary>本文目录 <span>CONTENTS</span></summary><nav>{toc.map(h=><a href={`#${h.slug}`} class:list={{sub:h.depth===3}}>{h.text}</a>)}</nav></details>}<div class="prose"><Content/></div><div class="article-end" data-pagefind-ignore>— 感谢阅读，愿有所收获 —</div></article><nav class="adjacent" aria-label="相邻文章">{older&&<a class="panel" href={url(`posts/${older.data.slug}/`)}><small>← 上一篇</small><b>{older.data.title}</b></a>}{newer&&<a class="panel" href={url(`posts/${newer.data.slug}/`)}><small>下一篇 →</small><b>{newer.data.title}</b></a>}</nav></Base>
