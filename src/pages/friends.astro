---
import Base from '../layouts/Base.astro';import friends from '../data/friends.json';import {site} from '../config/site';import {url} from '../lib/content';const info=`名称：${site.name}\n地址：${Astro.site}\n头像：${new URL(url('images/avatar.svg'),Astro.site)}\n简介：${site.description}`;
---
<Base title="友链" description="互联网很大，很高兴在这里遇见。"><div class="section-heading"><h2>常逛的站点<span>灵感与知识</span></h2><span class="muted">GOOD COMPANY</span></div><div class="friend-grid">{friends.map(f=><a class="panel friend" href={f.url} target="_blank" rel="noopener noreferrer"><span class="friend-avatar" style={`background:${f.color}`}>{f.letter}</span><div><h2>{f.name} <span>↗</span></h2><p>{f.description}</p></div></a>)}</div><section class="panel exchange"><span class="eyebrow">LET'S CONNECT</span><h2>交换一个友好的链接</h2><p>如果你也喜欢记录与分享，欢迎让我们的小站彼此相连。</p><pre id="friend-info">{info}</pre><button class="soft-button" data-copy="#friend-info">复制本站信息 ↗</button><p class="tiny">当前展示的是推荐资源，个人友链待补充。{site.email?<a href={`mailto:${site.email}`}>联系站长</a>:'暂未开放友链申请。'}</p></section></Base>
